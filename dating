<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Мышонок, пойдём гулять?</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Marck+Script&family=Nunito:wght@400;700&display=swap&subset=cyrillic" rel="stylesheet">
<style>
:root{--bg:#fff1ee;--ink:#3a1230;--muted:#7a5470;--accent:#d93a63;--accent-ink:#fff;--card:#fffaf8;--line:#e9b9bf;--veil:rgba(255,241,238,.72);
  box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#22092b;--ink:#ffe9e4;--muted:#c9a6c2;--accent:#ff7a93;--accent-ink:#2a0a22;--card:#33103d;--line:#6a3475;--veil:rgba(34,9,43,.72)}}
:root[data-theme="dark"]{--bg:#22092b;--ink:#ffe9e4;--muted:#c9a6c2;--accent:#ff7a93;--accent-ink:#2a0a22;--card:#33103d;--line:#6a3475;--veil:rgba(34,9,43,.72)}
html{height:100%;scroll-padding-top:env(safe-area-inset-top,0px)}
*,*::before,*::after{box-sizing:border-box}
body{margin:0;min-height:100%;display:grid;place-items:center;background:var(--bg);color:var(--ink);font:400 1.05rem/1.55 Nunito,system-ui,-apple-system,"Segoe UI",sans-serif;overflow-x:hidden}
main{width:min(100%,30rem);padding:1.5rem;text-align:center}
h1{font:400 clamp(2.6rem,11vw,4.4rem)/1.05 "Marck Script","Segoe Script","Brush Script MT",cursive;margin:0 0 .6rem}
.sub{color:var(--muted);margin:0 0 2rem}
.row{display:flex;gap:1rem;justify-content:center;align-items:center;min-height:4.5rem;flex-wrap:wrap}
button,.btn{font:700 1.05rem Nunito,system-ui,sans-serif;border:0;border-radius:999px;padding:.85rem 1.7rem;cursor:pointer;text-decoration:none;display:inline-block}
button:focus-visible,.btn:focus-visible{outline:3px solid var(--ink);outline-offset:3px}
#yes{background:var(--accent);color:var(--accent-ink);transition:transform .25s}
#no{background:transparent;color:var(--muted);border:2px solid var(--line);z-index:5}
#no.fly{position:fixed;transition:left .25s,top .25s}
.bg{position:fixed;inset:0;width:100%;height:100%;object-fit:cover;z-index:-2}
.veil{position:fixed;inset:0;background:var(--veil);z-index:-1}
.ticket{background:var(--card);border:2px dashed var(--line);border-radius:1.25rem;padding:1.5rem 1.25rem;margin:1.5rem 0;text-align:left}
.ticket dl{margin:0;display:grid;grid-template-columns:auto 1fr;gap:.6rem 1.1rem}
.ticket dt{color:var(--muted)}
.ticket dd{margin:0;font-weight:700}
.note{margin:1.1rem 0 0;padding-top:1rem;border-top:2px dotted var(--line);color:var(--muted)}
.heart{position:fixed;bottom:-2rem;font-size:1.6rem;pointer-events:none;animation:up 3s ease-in forwards}
@keyframes up{to{transform:translateY(-110vh) rotate(25deg);opacity:0}}
@media (prefers-reduced-motion:reduce){.heart{display:none}#yes,#no.fly{transition:none}}
[hidden]{display:none!important}
</style>
</head>
<body>
<video class="bg" id="bg" autoplay muted loop playsinline preload="auto" aria-hidden="true" src="data:video/mp4;base64,"></video>
<div class="veil"></div>
<main>
  <section id="ask">
    <h1 id="q"></h1>
    <p class="sub">Тёплая прогулка и хорошая компания. Выбирай внимательно.</p>
    <div class="row">
      <button id="yes" type="button">Да, пойдём гулять</button>
      <button id="no" type="button">Нет</button>
    </div>
  </section>
  <section id="done" hidden>
    <h1>Ура! Значит, гуляем</h1>
    <div class="ticket">
      <dl>
        <dt>Когда</dt><dd id="d-date"></dd>
        <dt>Во сколько</dt><dd id="d-time"></dd>
        <dt>Где</dt><dd id="d-place"></dd>
      </dl>
      <p class="note" id="d-note"></p>
    </div>
    <a class="btn" id="reply" style="background:var(--accent);color:var(--accent-ink)" target="_blank" rel="noopener" hidden>Сообщить, что я согласна</a>
  </section>
</main>
<script>
// ====== ЗАМЕНИТЕ НА СВОЁ ======
var CONFIG = {
  name: "Мышонок",               // как вы её называете (можно оставить пустым)
  date: "23 ноября, понедельник",
  time: "Вечером",
  place: "Прогулка по городу, маршрут сюрприз",
  note: "Оденься потеплее, мы будем долго гулять.",
  contact: "https://t.me/UserName132456"                     // ссылка для ответа, например https://t.me/ваш_ник (можно пусто)
};
// ===============================
var $ = function (id) { return document.getElementById(id); };
$("q").textContent = (CONFIG.name ? CONFIG.name + ", пойдём" : "Пойдём") + " гулять?";
$("d-date").textContent = CONFIG.date;
$("d-time").textContent = CONFIG.time;
$("d-place").textContent = CONFIG.place;
$("d-note").textContent = CONFIG.note;
if (CONFIG.contact) { $("reply").href = CONFIG.contact; $("reply").hidden = false; }

var phrases = ["Нет", "Мышонок, точно?", "Не поймаешь", "Подумай ещё", "Будет весело", "Ну пожалуйста"];
var vid = $("bg");
if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) { vid.removeAttribute("autoplay"); vid.pause(); }
else { var p = vid.play(); if (p && p.catch) p.catch(function () {}); }
var tries = 0, no = $("no"), yes = $("yes");

function dodge(e) {
  if (e) e.preventDefault();
  tries++;
  no.textContent = phrases[Math.min(tries, phrases.length - 1)];
  no.classList.add("fly");
  var w = no.offsetWidth, h = no.offsetHeight, m = 12;
  no.style.left = m + Math.random() * Math.max(0, window.innerWidth - w - 2 * m) + "px";
  no.style.top = m + Math.random() * Math.max(0, window.innerHeight - h - 2 * m) + "px";
  yes.style.transform = "scale(" + Math.min(1 + tries * 0.12, 1.8) + ")";
}
no.addEventListener("pointerenter", dodge);
no.addEventListener("pointerdown", dodge);
no.addEventListener("click", dodge);

yes.addEventListener("click", function () {
  $("ask").hidden = true;
  no.hidden = true;
  $("done").hidden = false;
  var s = ["🐭", "💗", "✨", "💕"];
  for (var i = 0; i < 26; i++) {
    var el = document.createElement("span");
    el.className = "heart";
    el.textContent = s[i % s.length];
    el.style.left = Math.random() * 96 + "vw";
    el.style.animationDelay = Math.random() * 1.2 + "s";
    document.body.appendChild(el);
    setTimeout(function (n) { n.remove(); }.bind(null, el), 5000);
  }
});
</script>
</body>
</html>
